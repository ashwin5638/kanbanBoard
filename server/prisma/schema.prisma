datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenants   Tenant[]
  users     User[]

  @@map("organizations")
}

model Tenant {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  boards         Board[]
  memberships    Membership[]
  activityLogs   ActivityLog[]

  @@index([organizationId])
  @@map("tenants")
}

model User {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  email          String        @unique
  passwordHash   String        @map("password_hash")
  name           String
  role           String        @default("MEMBER") // ORG_ADMIN, MEMBER
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  tasks          Task[]        @relation("AssignedTasks")
  activityLogs   ActivityLog[]

  @@index([organizationId])
  @@map("users")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("MEMBER") // TENANT_ADMIN, MEMBER
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

model Board {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  columns   Column[]

  @@index([tenantId])
  @@map("boards")
}

model Column {
  id       String @id @default(uuid())
  boardId  String @map("board_id")
  title    String
  position Int
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId])
  @@map("columns")
}

model Task {
  id           String   @id @default(uuid())
  columnId     String   @map("column_id")
  title        String
  description  String?
  position     Int
  assignedToId String?  @map("assigned_to_id")
  version      Int      @default(1) // Used for optimistic locking
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  column       Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignedTo   User?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([columnId])
  @@index([assignedToId])
  @@map("tasks")
}

model ActivityLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String   // e.g. "TASK_CREATED", "TASK_MOVED", "TASK_UPDATED", "TASK_DELETED", "BOARD_CREATED"
  entityType String   @map("entity_type") // "TASK", "BOARD", "COLUMN", "TENANT"
  entityId   String?  @map("entity_id")
  details    String
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@map("activity_logs")
}
