# Copy this file to .env (never commit .env).

PORT=5000
JWT_SECRET="change-me-to-a-long-random-string"

# Local development database: Prisma's local Postgres dev server.
# Start it first with `npm run db:start` (server name: kanban).
# The port is printed by `npm run db:status`; update it here if it ever changes.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/kanban?sslmode=disable"
